---
import { Button, FormInput, FormSelect, FormTextarea } from '@components/odyssey-theme';

const selectOptions = [
  "Restaurant / Bar",
  "Community Event / Festival",
  "Farmer's Market",
  "Downtown / Street Event",
  "Private Event",
  "Instagram",
  "Word of Mouth",
  "Other",
]

---

<form name="Booking Inquiry" method="POST" netlify>
  <FormInput type="text" label="Name" name="name" placeholder="Your name" required />
  <FormInput type="email" label="Email" name="email" placeholder="your@email.com" required />
  <FormInput type="text" label="Venue / Event Name" name="venue" placeholder="e.g. The Vine Restaurant, Pleasanton Farmer's Market" required />
  <FormInput type="text" label="Preferred Dates / Timeframe" name="dates" placeholder="e.g. July weekends, any Saturday in August" required />
  <FormSelect label="Venue Type / How Did You Hear About Us?" name="venuetype" options={selectOptions} required />
  <FormTextarea label="Tell us about your event" name="message" placeholder="Describe your space, expected audience size, set length, and anything else we should know..." required />
  <Button type="submit">Send Inquiry</Button>
</form>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
</style>