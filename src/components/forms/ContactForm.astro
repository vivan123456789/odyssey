---
import { Button, FormInput, FormSelect, FormTextarea } from '@components/odyssey-theme';

const selectOptions = [
  "Restaurant / Bar",
  "Community Event / Festival",
  "Farmer's Market",
  "Downtown / Street Event",
  "Private Event",
  "Instagram",
  "Word of Mouth",
  "Other",
]

---

<form name="Booking Inquiry" method="POST" action="/contact-thank-you">
  <FormInput type="text" label="Name" name="Name" placeholder="Your name" />
  <FormInput type="email" label="Email" name="Email" placeholder="your@email.com" />
  <FormInput type="text" label="Venue / Event Name" name="Venue" placeholder="e.g. The Vine Restaurant, Pleasanton Farmer's Market" />
  <FormInput type="text" label="Preferred Dates / Timeframe" name="Dates" placeholder="e.g. July weekends, any Saturday in August" />
  <FormSelect label="Venue Type / How Did You Hear About Us?" options={selectOptions} />
  <FormTextarea label="Tell us about your event" name="Message" placeholder="Describe your space, expected audience size, set length, and anything else we should know..." />
  <Button>Send Inquiry</Button>
</form>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
</style>
