---
import { Container, Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
  title: 'Roster | Playing It Forward',
  description: 'Meet the musicians of Playing It Forward — a rotating Bay Area collective spanning bass, guitar, drums, vocals, keys, and horn section.',
};

const roster = [
  {
    section: 'Bass',
    icon: '🎸',
    members: ['Pranav D', 'Vivek Matam', 'Aga'],
  },
  {
    section: 'Guitar',
    icon: '🎵',
    members: ['Zach', 'Daniel', 'Ayaan', 'Raunak', 'Rishab'],
  },
  {
    section: 'Drums',
    icon: '🥁',
    members: ['Joon', 'Ayaan', 'Raunak', 'Tanay', 'Pranav S'],
  },
  {
    section: 'Vocals',
    icon: '🎤',
    members: ['Rishab', 'Shashank', 'Vinnakota', 'Akshay', 'Ayaan'],
  },
  {
    section: 'Keys',
    icon: '🎹',
    members: ['Aga', 'Ayaan'],
  },
  {
    section: 'Horn Section',
    icon: '🎺',
    members: ['Rohan (Sax)', 'Zafir (Sax)', 'Sid (Sax)', 'Meng (Sax)', 'Aga (Trumpet)'],
  },
];
---

<Layout {seo}>
  <Container>
    <section class="roster-hero">
      <h1>The Roster</h1>
      <p class="roster-subtitle">
        Playing It Forward is a collective, not a fixed band. Our roster spans over 20 musicians across the Bay Area — assembled show by show based on availability and venue needs.
      </p>
    </section>

    <section class="roster-grid">
      {roster.map((section) => (
        <div class="roster-section-card">
          <div class="roster-section-header">
            <span class="roster-icon">{section.icon}</span>
            <h2 class="roster-section-title">{section.section}</h2>
          </div>
          <ul class="roster-member-list">
            {section.members.map((member) => (
              <li class="roster-member">{member}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="roster-note">
      <p>
        Many collective members play multiple instruments and sections. Ayaan, for example, appears across guitar, drums, vocals, and keys. Shows are assembled from this roster based on size, venue, and set type — every configuration brings something different.
      </p>
      <div class="roster-cta">
        <Button href="/company/contact">Get in Touch to Book</Button>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .roster-hero {
    margin: var(--section-margin) auto 3rem;
    max-width: 42rem;
  }
  .roster-subtitle {
    font-size: var(--font-size-lg);
    opacity: 0.8;
    margin-top: 1rem;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--theme-grid-gap);
  }
  .roster-section-card {
    background: var(--theme-surface-1);
    border-radius: var(--theme-shape-radius);
    padding: 2rem;
  }
  .roster-section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .roster-icon {
    font-size: 2rem;
  }
  .roster-section-title {
    margin: 0;
    font-size: 1.25rem;
  }
  .roster-member-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .roster-member {
    padding: 0.5rem 0;
    font-size: 0.95rem;
    opacity: 0.9;
  }
  .roster-note {
    margin: var(--section-margin) auto 0;
    text-align: center;
  }
  .roster-cta {
    margin-top: 2rem;
  }
</style>