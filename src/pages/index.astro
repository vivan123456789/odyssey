---
import { Container, Button, ThreeColumnTextSection, CtaCardSection } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
---

<Layout>
	<HomeHeroSection />

	<Container>
		<section class="stats__section">
			<div class="stat-item">
				<span class="stat-number">2–4</span>
				<span class="stat-label">shows per week</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">6</span>
				<span class="stat-label">Bay Area regions</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">20+</span>
				<span class="stat-label">musicians in the collective</span>
			</div>
		</section>
	</Container>

	<ThreeColumnTextSection>
		<div slot="column-1-body">
			<h2>Who We Are</h2>
			<p>
				Playing It Forward is a rotating cast of Bay Area musicians — bassists, guitarists, drummers, vocalists, keyboardists, and a full horn section — united for live music and community impact. <strong>Gigs for Good.</strong>
			</p>
		</div>
		<Button slot="column-1-cta" href="/company/about">Our Story</Button>
		<div slot="column-2-body">
			<h2>Where We Play</h2>
			<p>
				We target restaurants, downtown foot-traffic spots, and local community hubs across SF, Oakland, Berkeley, San Jose, Marin, and Half Moon Bay — bringing the music to where people already are.
			</p>
		</div>
		<Button slot="column-2-cta" href="/shows" outlined>See Show Info</Button>
		<div slot="column-3-body">
			<h2>Why We Do It</h2>
			<p>
				Every show raises money for niche, high-impact charitable initiatives. We believe music can do more than entertain — it can change things. We choose causes that need a spotlight, not just a dollar.
			</p>
		</div>
		<Button slot="column-3-cta" href="/blog">Read More</Button>
	</ThreeColumnTextSection>

	<Container>
		<section class="venue-section">
			<h2>Venue Targets</h2>
			<p class="venue-intro">We bring full energy to the right spaces. Here's where we look to perform:</p>
			<div class="venue-grid">
				<div class="venue-card">
					<Icon name="ic:baseline-restaurant" width={32} height={32} />
					<h3>Restaurants</h3>
					<p>Evening sets that elevate the dining experience and drive foot traffic for venue partners.</p>
				</div>
				<div class="venue-card">
					<Icon name="ic:baseline-location-city" width={32} height={32} />
					<h3>Downtown Spots</h3>
					<p>High foot-traffic intersections, plazas, and commercial corridors across the Tri-Valley and Bay.</p>
				</div>
				<div class="venue-card">
					<Icon name="ic:baseline-people" width={32} height={32} />
					<h3>Community Hubs</h3>
					<p>Farmer's markets, parks, neighborhood festivals, and local gathering spaces.</p>
				</div>
			</div>
		</section>
	</Container>

	<CtaCardSection
		background="var(--theme-surface-2)"
		color="var(--theme-on-surface-2)"
	>
		<h2>Want to book us?</h2>
		<p>
			We're available 2–4 shows per week throughout the summer. Reach out and let's make something happen.
		</p>
		<Button href="/company/contact" customIcon
			>Send an Inquiry <Fragment slot="icon">
				<Icon name="ic:baseline-chevron-right" />
			</Fragment></Button
		>
	</CtaCardSection>
</Layout>

<style>
	.stats__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
		text-align: center;
	}
	.stat-item {
		padding: 2rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.stat-number {
		font-family: var(--theme-font-family-serif);
		font-size: 3rem;
		font-weight: 700;
		color: var(--theme-primary);
		line-height: 1;
	}
	.stat-label {
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.75;
	}
	.venue-section {
		margin: var(--section-margin) auto;
	}
	.venue-intro {
		margin-bottom: 2rem;
		max-width: 40rem;
	}
	.venue-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
	}
	.venue-card {
		padding: 2rem;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.venue-card h3 {
		margin: 0;
	}
	.venue-card p {
		margin: 0;
		opacity: 0.85;
	}
	@media (max-width: 768px) {
		.stats__section,
		.venue-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
