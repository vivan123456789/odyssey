---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';

const seo = {
  title: 'Videos | Playing It Forward',
  description: 'Watch performances from Playing It Forward on Instagram @fhs.livemusic',
};
---

<Layout {seo}>
  <Container>
    <section class="past-work-hero">
      <h1>Videos</h1>
      <p class="past-work-subtitle">
        Check out our performances and highlights on Instagram.
      </p>
    </section>

    <section class="instagram-section">
      <div class="instagram-content">
        <div class="instagram-header">
          <Icon name="mdi:instagram" width={48} height={48} />
          <h2>@fhs.livemusic</h2>
        </div>
        <p class="instagram-description">
          Follow Playing It Forward on Instagram for the latest performance videos, clips, and updates from our shows across the Bay Area.
        </p>
        <Button href="https://instagram.com/fhs.livemusic" target="_blank" customIcon>
          Follow on Instagram <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right" />
          </Fragment>
        </Button>
      </div>

      <div class="video-grid">
        {[1, 2, 3, 4, 5, 6].map((num) => (
          <div class="video-placeholder-card">
            <div class="video-placeholder">
              <Icon name="ic:baseline-video-library" width={64} height={64} />
              <p>Video spot {num}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </Container>

  <CtaCardSection
    background="var(--theme-surface-2)"
    color="var(--theme-on-surface-2)"
  >
    <h2>Want to see us live?</h2>
    <p>Check out our upcoming shows and book us for your venue.</p>
    <Button href="/shows" customIcon
      >View Shows <Fragment slot="icon">
        <Icon name="ic:baseline-chevron-right" />
      </Fragment></Button
    >
  </CtaCardSection>
</Layout>

<style>
  .past-work-hero {
    margin: var(--section-margin) auto 3rem;
    max-width: 42rem;
  }

  .past-work-subtitle {
    font-size: var(--font-size-lg);
    opacity: 0.8;
    margin-top: 1rem;
  }

  .instagram-section {
    margin-bottom: var(--section-margin);
  }

  .instagram-content {
    background: var(--theme-surface-1);
    padding: 3rem 2rem;
    border-radius: var(--theme-shape-radius);
    text-align: center;
    margin-bottom: 3rem;
  }

  .instagram-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .instagram-header h2 {
    margin: 0;
    font-size: var(--font-size-xl);
  }

  .instagram-description {
    font-size: var(--font-size-md);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--theme-grid-gap);
  }

  .video-placeholder-card {
    background: var(--theme-surface-1);
    border-radius: var(--theme-shape-radius);
    overflow: hidden;
  }

  .video-placeholder {
    width: 100%;
    aspect-ratio: 9 / 16;
    background: var(--theme-surface-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--theme-on-surface-2);
    opacity: 0.5;
  }

  .video-placeholder p {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .instagram-content {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
