---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';

const seo = {
  title: 'Past Work | [summer larp]',
  description: 'Watch performances and highlights from [summer larp] shows across the Bay Area.',
};

const videoSections = [
  {
    title: 'Recent Performances',
    videos: [
      {
        id: 'video-1',
        videoUrl: '',
        caption: 'Add your video URL and caption here',
        title: 'Performance 1',
      },
      {
        id: 'video-2',
        videoUrl: '',
        caption: 'Add your video URL and caption here',
        title: 'Performance 2',
      },
      {
        id: 'video-3',
        videoUrl: '',
        caption: 'Add your video URL and caption here',
        title: 'Performance 3',
      },
    ],
  },
  {
    title: 'Highlights & Clips',
    videos: [
      {
        id: 'clip-1',
        videoUrl: '',
        caption: 'Add your video URL and caption here',
        title: 'Highlight 1',
      },
      {
        id: 'clip-2',
        videoUrl: '',
        caption: 'Add your video URL and caption here',
        title: 'Highlight 2',
      },
    ],
  },
];
---

<Layout {seo}>
  <Container>
    <section class="past-work-hero">
      <h1>Past Work</h1>
      <p class="past-work-subtitle">
        Explore videos and highlights from [summer larp] performances across the Bay Area.
      </p>
    </section>

    {videoSections.map((section) => (
      <section class="video-section">
        <h2>{section.title}</h2>
        <div class="video-grid">
          {section.videos.map((video) => (
            <div class="video-card">
              <div class="video-placeholder">
                {video.videoUrl ? (
                  <iframe
                    src={video.videoUrl}
                    title={video.title}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <div class="video-empty">
                    <Icon name="ic:baseline-video-library" width={48} height={48} />
                    <p>Video placeholder</p>
                  </div>
                )}
              </div>
              <div class="video-info">
                <h3>{video.title}</h3>
                <p class="video-caption">{video.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </Container>

  <CtaCardSection
    background="var(--theme-surface-2)"
    color="var(--theme-on-surface-2)"
  >
    <h2>Want to see us live?</h2>
    <p>Check out our upcoming shows and book us for your venue.</p>
    <Button href="/shows" customIcon
      >View Shows <Fragment slot="icon">
        <Icon name="ic:baseline-chevron-right" />
      </Fragment></Button
    >
  </CtaCardSection>
</Layout>

<style>
  .past-work-hero {
    margin: var(--section-margin) auto 3rem;
    max-width: 42rem;
  }

  .past-work-subtitle {
    font-size: var(--font-size-lg);
    opacity: 0.8;
    margin-top: 1rem;
  }

  .video-section {
    margin-bottom: var(--section-margin);
  }

  .video-section h2 {
    margin-bottom: 2rem;
    font-size: var(--font-size-xl);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--theme-grid-gap);
  }

  .video-card {
    background: var(--theme-surface-1);
    border-radius: var(--theme-shape-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .video-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--theme-surface-2);
    position: relative;
    overflow: hidden;
  }

  .video-placeholder iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--theme-on-surface-2);
    opacity: 0.5;
  }

  .video-info {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .video-info h3 {
    margin: 0 0 0.75rem 0;
    font-size: var(--font-size-md);
  }

  .video-caption {
    margin: 0;
    font-size: var(--font-size-sm);
    opacity: 0.75;
    flex: 1;
  }

  @media (max-width: 768px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
