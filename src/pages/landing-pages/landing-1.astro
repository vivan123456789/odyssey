---
import { Icon } from 'astro-icon/components';
import {
	AnnouncementBar,
	Button,
	CustomerQuoteSection,
	ThreeColumnTextSection,
	StickyTextImageSection,
	CtaCardSection,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';
import { Fragment } from 'astro';

const seo = {
	title: 'Book Playing It Forward | Bay Area Music Collective',
	description: 'Hire Playing It Forward for your restaurant, event, or community space. A Bay Area music collective playing for a cause.',
};
---

<Layout {seo}>
	<TextAndImageHero reversed>
		<div slot="text-container">
			<h1>Live Music. Real Impact.</h1>
			<p>Book Playing It Forward for your venue or event — a rotating Bay Area collective that plays great music and raises funds for high-impact causes.</p>
		</div>
		<div slot="btns-container">
			<Button href="/company/contact" customIcon
				>Send a Booking Inquiry <Fragment slot="icon">
					<Icon name="ic:baseline-chevron-right" />
				</Fragment></Button
			>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/landing-1/landing-hero-1.jpg"
				alt="Playing It Forward performing live"
				id="home-hero-image"
			/>
		</picture>
	</TextAndImageHero>

	<CustomerQuoteSection
		quoteText="The energy was incredible — they brought the whole room to life. And knowing the proceeds went to a great cause made it even better."
		customerName="Venue Partner, Dublin CA"
	/>

	<ThreeColumnTextSection>
		<div slot="column-1-body">
			<h2>Flexible Setup</h2>
			<p>
				From a tight trio to a full 10+ piece ensemble with horns — we scale to your venue and your vision. Tell us what you need and we'll make it work.
			</p>
		</div>
		<Button slot="column-1-cta" href="/roster">See the Roster</Button>
		<div slot="column-2-body">
			<h2>Built for Foot Traffic</h2>
			<p>
				We target restaurants, farmer's markets, downtown spots, and community hubs. Places where live music can reach people who weren't expecting it.
			</p>
		</div>
		<Button slot="column-2-cta" href="/shows" outlined>Show Info</Button>
		<div slot="column-3-body">
			<h2>Giving Baked In</h2>
			<p>
				Every show includes a charitable component. We handle the charity selection and communications — you get a great show with a story your customers will remember.
			</p>
		</div>
		<Button slot="column-3-cta" href="/company/about">Our Mission</Button>
	</ThreeColumnTextSection>

	<StickyTextImageSection>
		<div slot="text-container">
			<h2>Why Playing It Forward?</h2>
			<h3>A Rotating Roster</h3>
			<p>
				Over 20 musicians spanning bass, guitar, drums, vocals, keys, and a full horn section. Each show is assembled for the occasion.
			</p>
			<h3>Bay Area Coverage</h3>
			<p>
				Home base in Pleasanton/Dublin/Livermore, with reach across SF, Oakland, Berkeley, San Jose, Marin, and Half Moon Bay.
			</p>
			<h3>2–4 Shows Per Week</h3>
			<p>
				Available throughout the summer. Reach out early to lock in your preferred dates.
			</p>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/landing-1/landing-sticky.jpg"
				alt="Playing It Forward collective"
				loading="lazy"
			/>
		</picture>
	</StickyTextImageSection>

	<CtaCardSection
		background="var(--theme-surface-2)"
		color="var(--theme-on-surface-2)"
	>
		<h2>Ready to book?</h2>
		<p>
			Fill out a booking inquiry and we'll get back to you within a couple days to discuss dates, configuration, and logistics.
		</p>
		<Button href="/company/contact" customIcon
			>Send an Inquiry <Fragment slot="icon">
				<Icon name="ic:baseline-chevron-right" />
			</Fragment></Button
		>
	</CtaCardSection>
</Layout>