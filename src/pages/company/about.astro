---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About | Playing It Forward',
	description: 'Learn about Playing It Forward, the Bay Area music collective with the motto Gigs for Good — running a summer gigging circuit to raise funds for high-impact charitable causes.',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>About Playing It Forward</h1>
			<p>
				A Bay Area music collective on a mission — playing shows, building community, and raising funds for causes that matter, one gig at a time. <strong>Gigs for Good.</strong>
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/classic-hero.jpg"
        alt="Playing It Forward collective performing"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>

  <TextSection narrow>
    <h2>Our Story</h2>
    <p>
      Playing It Forward started as a conversation between four friends — Vivan, Abhee, Ayaan, and Shashank — who wanted to make the most of a summer and use music as a vehicle for something bigger.
    </p>
    <p>
      Based in the Tri-Valley (Pleasanton, Dublin, and Livermore), the collective draws from a rotating roster of over 20 musicians spanning bass, guitar, drums, vocals, keys, and a full horn section.
    </p>

    <h2>The Mission</h2>
    <p>
      Every show we play raises money for a charitable cause. But we're deliberate about which ones. Rather than defaulting to well-known brands, we seek out niche, high-impact initiatives that do meaningful work.
    </p>
    <p>
      We believe the collective can do more than entertain. Music is a natural meeting place. When you combine a great show with a meaningful cause, you get something that people remember and want to be part of.
    </p>

    <h2>The Circuit</h2>
    <p>
      The summer circuit runs 2–4 shows per week across the Bay Area, with a radius covering San Francisco, Oakland, Berkeley, San Jose, Marin, and Half Moon Bay. We prioritize venues with existing audiences and real community impact.
    </p>
    <p>
      Want to have us play at your venue or event? Head to our <a href="/company/contact">Inquiry page</a> or find us on Instagram to start the conversation.
    </p>
  </TextSection>
</Layout>