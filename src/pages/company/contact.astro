---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Booking Inquiry | Playing It Forward',
	description: 'Get in touch with Playing It Forward to book a show at your venue or event across the Bay Area.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>Book Playing It Forward</h1>
				<p>
					Interested in having us play at your restaurant, event, market, or community space? Fill out the form and we'll get back to you within a couple of days to discuss availability, set size, and logistics.
				</p>
				<p>
					We're available <strong>2–4 shows per week</strong> throughout the summer, serving the full Bay Area — SF, Oakland, Berkeley, San Jose, Marin, and Half Moon Bay.
				</p>
				<div class="contact-links">
					<p>
						<strong>Email:</strong> <a href="mailto:playingitforward2026@gmail.com">playingitforward2026@gmail.com</a>
					</p>
					<p>
						<strong>Instagram:</strong> <a href="https://instagram.com/fhs.livemusic" target="_blank" rel="noopener noreferrer">@fhs.livemusic</a> <!-- Update with real handle -->
					</p>
				</div>
				<p class="contact-note">
					For general questions, DMs on Instagram also work. We check regularly.
				</p>
			</div>
			<div class="col-2__container">
				<ContactForm />
			</div>
		</section>
	</Container>
</Layout>

</style>
