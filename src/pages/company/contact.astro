---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Booking Inquiry | [summer larp]',
	description: 'Get in touch with [summer larp] to book a show at your venue or event across the Bay Area.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>Book [summer larp]</h1>
				<p>
					Interested in having us play at your restaurant, event, market, or community space? Fill out the form and we'll get back to you within a couple of days to discuss availability, set size, and logistics.
				</p>
				<p>
					We're available <strong>2–4 shows per week</strong> throughout the summer, serving the full Bay Area — SF, Oakland, Berkeley, San Jose, Marin, and Half Moon Bay.
				</p>
				<div class="contact-links">
					<p>
						<strong>Email:</strong> <a href="mailto:summerlarp@gmail.com">summerlarp@gmail.com</a>
					</p>
					<p>
						<strong>Instagram:</strong> <a href="https://instagram.com/summerlarp" target="_blank" rel="noopener noreferrer">@summerlarp</a> <!-- Update with real handle -->
					</p>
				</div>
				<p class="contact-note">
					For general questions, DMs on Instagram also work. We check regularly.
				</p>
			</div>
			<div class="col-2__container">
				<ContactForm />
			</div>
		</section>
	</Container>
</Layout>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.contact-links {
		margin: 1rem 0;
		padding: 1rem;
		background: var(--theme-surface-2);
		border-radius: var(--theme-shape-radius);
	}
	.contact-links p {
		margin: 0.4rem 0;
	}
	.contact-note {
		font-size: var(--font-size-sm);
		opacity: 0.75;
		margin-top: 0.5rem;
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
	}
</style>
