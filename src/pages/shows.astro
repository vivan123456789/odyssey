---
import { Container, Button, CtaCardSection } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';

const seo = {
  title: 'Shows | Playing It Forward',
  description: 'Booking info for Playing It Forward — availability, performance radius, and venue types across the Bay Area. Gigs for Good.',
};

const regions = [
  { name: 'San Francisco', note: 'Mission, SOMA, North Beach, Hayes Valley' },
  { name: 'Oakland', note: 'Uptown, Temescal, Grand Lake, Fruitvale' },
  { name: 'Berkeley', note: 'Telegraph Ave, Downtown Berkeley, Elmwood' },
  { name: 'San Jose', note: 'Downtown, Santana Row, Willow Glen' },
  { name: 'Marin', note: 'Mill Valley, San Rafael, Fairfax' },
  { name: 'Half Moon Bay', note: 'Main St, coastal festivals, waterfront events' },
];
---

<Layout {seo}>
  <Container>
    <section class="shows-hero">
      <h1>Shows & Booking</h1>
      <p class="shows-subtitle">
        We run 2–4 shows per week throughout the summer, across the Bay Area and beyond. <strong>Gigs for Good.</strong>
      </p>
    </section>

    <section class="availability-section">
      <div class="availability-card primary-card">
        <Icon name="ic:baseline-event" width={36} height={36} />
        <h2>Availability</h2>
        <p class="avail-number">2–4</p>
        <p>shows per week, bookable through the summer season.</p>
        <p>We accommodate evening sets, weekend daytime sets, and festival/market slots. Reach out to discuss dates and logistics.</p>
      </div>
      <div class="availability-card">
        <Icon name="ic:baseline-place" width={36} height={36} />
        <h2>Performance Radius</h2>
        <p>We operate across the greater Bay Area, with home base in the Tri-Valley (Pleasanton, Dublin, Livermore).</p>
        <ul class="region-list">
          {regions.map((r) => (
            <li>
              <strong>{r.name}</strong>
              <span>{r.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="venue-types-section">
      <h2>Ideal Venue Types</h2>
      <p>We work with a range of spaces. Below are our primary targets — but if your venue feels like a fit, reach out anyway.</p>
      <div class="venue-type-grid">
        <div class="venue-type-card">
          <h3>Restaurants & Bars</h3>
          <p>Evening sets (typically 7–10pm) that add atmosphere and draw customers. Flexible setups from trio to full horn section depending on space.</p>
        </div>
        <div class="venue-type-card">
          <h3>Downtown & Street-Level</h3>
          <p>Plazas, pedestrian corridors, and commercial districts with existing foot traffic. Great for awareness-building shows that maximize exposure.</p>
        </div>
        <div class="venue-type-card">
          <h3>Farmer's Markets</h3>
          <p>Weekend morning and midday sets at local markets. A natural fit for fundraising — engaged, community-oriented audiences.</p>
        </div>
        <div class="venue-type-card">
          <h3>Community Events & Festivals</h3>
          <p>Block parties, neighborhood festivals, school and non-profit events. We're happy to align our charitable angle with the event's own mission.</p>
        </div>
      </div>
    </section>

    <section class="logistics-section">
      <h2>Logistics Notes</h2>
      <div class="logistics-grid">
        <div class="logistics-item">
          <h3>Set Size</h3>
          <p>Trio to full 10+ piece ensemble depending on venue, occasion, and member availability. We'll discuss the right configuration for your space.</p>
        </div>
        <div class="logistics-item">
          <h3>Genres</h3>
          <p>The collective covers a wide range — funk, R&B, jazz, rock, pop, and original material. Set lists are built to match the room.</p>
        </div>
        <div class="logistics-item">
          <h3>Charity Component</h3>
          <p>All shows include a fundraising element. We handle the charity selection and communication — venues and organizers are encouraged to participate.</p>
        </div>
        <div class="logistics-item">
          <h3>Payment</h3>
          <p>We work with venues on a case-by-case basis. Some shows are door-deal, some are flat fee, some are purely charity-driven. Let's talk.</p>
        </div>
      </div>
    </section>
  </Container>

  <CtaCardSection
    background="var(--theme-surface-2)"
    color="var(--theme-on-surface-2)"
  >
    <h2>Ready to book Playing It Forward?</h2>
    <p>Fill out an inquiry form and we'll get back to you within a couple days to discuss availability, set size, and logistics.</p>
    <Button href="/company/contact" customIcon
      >Send an Inquiry <Fragment slot="icon">
        <Icon name="ic:baseline-chevron-right" />
      </Fragment></Button
    >
  </CtaCardSection>
</Layout>

<style>
  .shows-hero {
    margin: var(--section-margin) auto 3rem;
    max-width: 42rem;
  }
  .shows-subtitle {
    font-size: var(--font-size-lg);
    opacity: 0.8;
    margin-top: 1rem;
  }
  .availability-section {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--theme-grid-gap);
    margin-bottom: var(--section-margin);
  }
  .availability-card {
    background: var(--theme-surface-1);
    border-radius: var(--theme-shape-radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .availability-card h2 {
    margin: 0;
  }
  .primary-card {
    background: var(--theme-primary);
    color: var(--theme-on-primary);
  }
  .avail-number {
    font-family: var(--theme-font-family-serif);
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }
  .region-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .region-list li {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--theme-surface-2);
    padding-bottom: 0.5rem;
    font-size: var(--font-size-sm);
  }
  .region-list li:last-child {
    border-bottom: none;
  }
  .region-list span {
    opacity: 0.7;
  }
  .venue-types-section {
    margin-bottom: var(--section-margin);
  }
  .venue-type-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--theme-grid-gap);
    margin-top: 1.5rem;
  }
  .venue-type-card {
    background: var(--theme-surface-1);
    border-radius: var(--theme-shape-radius);
    padding: 1.75rem;
  }
  .venue-type-card h3 {
    margin-top: 0;
  }
  .logistics-section {
    margin-bottom: var(--section-margin);
  }
  .logistics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--theme-grid-gap);
    margin-top: 1.5rem;
  }
  .logistics-item {
    padding: 1.5rem;
    border-left: 3px solid var(--theme-primary);
  }
  .logistics-item h3 {
    margin-top: 0;
  }
  @media (max-width: 768px) {
    .availability-section,
    .venue-type-grid,
    .logistics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
