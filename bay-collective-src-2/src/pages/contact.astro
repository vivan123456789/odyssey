---
import Layout from '../layouts/Page.astro';
import HeroSection from '../components/sections/heros/HeroSection.astro';
import TextSection from '../components/sections/TextSection.astro';

const seo = {
  title: 'Book a Show — Bay Collective',
  description:
    'Book Bay Collective for your venue. Restaurants, plazas, community events — we configure to your space.',
};
---

<Layout seo={seo}>
  <HeroSection
    tagline="Book a Show"
    title="Let's play your venue."
    text="Tell us about your space. We configure to any size — intimate acoustic trio to full band with horns. We handle logistics end to end."
  />

  <section style="padding: 3rem 2rem; max-width: 680px; margin: 0 auto;">

    <!-- ─────────────────────────────────────────────────────────────────
         FORMSPREE SETUP (one-time, takes 2 minutes):
         1. Go to https://formspree.io and sign up for free
         2. Click "New Form", name it "Bay Collective Booking"
         3. Copy your form ID (looks like: xrgvkwpb)
         4. Replace YOUR_FORM_ID below with that ID
         ───────────────────────────────────────────────────────────────── -->

    <form
      id="booking-form"
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
      style="display: flex; flex-direction: column; gap: 1.25rem;"
    >
      <!-- Honeypot spam field — hidden from real users -->
      <input type="text" name="_gotcha" style="display:none" />
      <!-- Redirect after submit -->
      <input type="hidden" name="_next" value="/contact-success" />
      <!-- Email subject line -->
      <input type="hidden" name="_subject" value="New Show Booking Inquiry — Bay Collective" />

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Your Name *</label>
        <input type="text" name="name" required
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;" />
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Venue / Organization *</label>
        <input type="text" name="venue" required
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;" />
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Email *</label>
        <input type="email" name="email" required
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;" />
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">City / Location</label>
        <input type="text" name="location" placeholder="e.g. Pleasanton, Oakland, San Francisco"
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;" />
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Venue Type</label>
        <select name="venue_type"
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;">
          <option>Restaurant / Bar</option>
          <option>Outdoor / Plaza</option>
          <option>Community Event</option>
          <option>Corporate / Private</option>
          <option>Market / Festival</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Preferred Dates / Frequency</label>
        <input type="text" name="dates" placeholder="e.g. Friday evenings, weekly, specific date"
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;" />
      </div>

      <div>
        <label style="display:block;font-weight:600;margin-bottom:0.4rem;font-size:0.9rem;">Message</label>
        <textarea name="message" rows="5"
          placeholder="Tell us about your venue, expected crowd size, indoor/outdoor, and anything else..."
          style="width:100%;padding:0.65rem 0.9rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;resize:vertical;"></textarea>
      </div>

      <div id="form-status" style="display:none;padding:0.75rem 1rem;border-radius:6px;font-size:0.9rem;"></div>

      <button type="submit" id="submit-btn"
        style="background:#111827;color:white;padding:0.85rem 2rem;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;width:fit-content;transition:opacity 0.2s;">
        Send Inquiry →
      </button>
    </form>

    <script>
      const form = document.getElementById('booking-form');
      const status = document.getElementById('form-status');
      const btn = document.getElementById('submit-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.textContent = 'Sending...';
        btn.style.opacity = '0.6';
        btn.disabled = true;

        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          status.style.display = 'block';
          status.style.background = '#d1fae5';
          status.style.color = '#065f46';
          status.textContent = "✓ Got it! We'll be in touch within 48 hours.";
          form.reset();
          btn.textContent = 'Sent!';
        } else {
          status.style.display = 'block';
          status.style.background = '#fee2e2';
          status.style.color = '#991b1b';
          status.textContent = 'Something went wrong. Email us directly at booking@baycollective.com';
          btn.textContent = 'Send Inquiry →';
          btn.style.opacity = '1';
          btn.disabled = false;
        }
      });
    </script>
  </section>

  <TextSection narrow>
    <h2>Other ways to reach us</h2>
    <p>
      <strong>Email:</strong> booking@baycollective.com<br />
      <strong>Instagram:</strong> @baycollective<br />
      <strong>Based in:</strong> Pleasanton, CA — serving the Bay Area
    </p>
    <p>
      We typically respond within 48 hours. For urgent bookings, email is fastest.
    </p>
  </TextSection>
</Layout>
